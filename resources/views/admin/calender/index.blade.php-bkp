            $('#service_id').on('change', function () {
                let serviceIds = $(this).val(); // selected service IDs (array from select2)

                if (serviceIds.length > 0) {
                    $.ajax({
                        url: "{{ route('admin.staffby.services') }}",
                        type: "GET",
                        data: { service_ids: serviceIds },
                        success: function (response) {
                            $('#staff_id').empty();
                            $('#staff_id').append('<option value="">Select Staff</option>');

                            $.each(response.data, function (key, staff) {
                                $('#staff_id').append('<option value="' + staff.id + '">' + staff.name + '</option>');
                            });
                        }
                    });
                } else {
                    $('#staff_id').empty().append('<option value="">Select Staff</option>');
                }
            });


            $('#appointmentForm').on('submit', function (e) {
                e.preventDefault();
                let totalDuration = 0;

                // loop through selected services
                $('#service_id option:selected').each(function () {
                    let duration = parseInt($(this).data('min')) || 0;
                    totalDuration += duration;
                });

                if ($("#total_duration").length === 0) {
                    $('<input>').attr({
                        type: 'hidden',
                        id: 'total_duration',
                        name: 'total_duration',
                        value: totalDuration
                    }).appendTo('#appointmentForm');
                } else {
                    $("#total_duration").val(totalDuration);
                }

                $.ajax({
                    url: "{{ route('admin.calender.book.store') }}", // Laravel route
                    type: "POST",
                    data: $(this).serialize(), // Serialize form data
                    beforeSend: function () {
                        // Optional: Disable submit button / show loader
                    },
                    success: function (response) {
                        $('#addAppointmentModal').modal('hide');
                        if (response.status==200) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.msg,
                                showConfirmButton: false,
                                timer: 2000
                            });
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            Swal.fire({
                                icon: 'Warning',
                                title: 'Warning',
                                text: response.msg,
                                showConfirmButton: true,
                                // timer: 2000/
                            });
                            // setTimeout(() => location.reload(), 1000);
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 422) {
                            let errors = xhr.responseJSON.errors;
                            msg="";
                            $.each(errors, function (key, value) {
                                msg+=value[0];
                            });

                            Swal.fire({
                                icon: 'Warning',
                                title: 'Warning',
                                text: msg,
                                showConfirmButton: false,
                                timer: 2000
                            });
                        } else {
                            toastr.error("Server error, please try again.");
                        }
                    }
                });
            });

            $('#breakForm').on('submit', function (e) {
                e.preventDefault();

                $.ajax({
                    url: "{{ route('admin.calender.breakFormSubmit') }}", // Laravel route
                    type: "POST",
                    data: $(this).serialize(), // Serialize form data
                    beforeSend: function () {
                        // Optional: Disable submit button / show loader
                    },
                    success: function (response) {
                        $('#breakFormModal').modal('hide');
                        if (response.status==200) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success',
                                text: response.msg,
                                showConfirmButton: false,
                                timer: 2000
                            });
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            Swal.fire({
                                icon: 'Warning',
                                title: 'Warning',
                                text: response.msg,
                                showConfirmButton: false,
                                timer: 2000
                            });
                            setTimeout(() => location.reload(), 1000);
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 422) {
                            let errors = xhr.responseJSON.errors;
                            msg="";
                            $.each(errors, function (key, value) {
                                msg+=value[0];
                            });

                            Swal.fire({
                                icon: 'Warning',
                                title: 'Warning',
                                text: msg,
                                showConfirmButton: false,
                                timer: 2000
                            });
                        } else {
                            toastr.error("Server error, please try again.");
                        }
                    }
                });
            });


        });
