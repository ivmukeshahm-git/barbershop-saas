@push('script')
    <script>
        $(document).ready(function() {

            // Initialize DataTables
            var ReportAppointmentsList = $('#ReportAppointmentsListDataTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: "{{ route('admin.reports.get-report-appointment') }}",
                    type: "POST",
                    data: function(d) {
                        d._token = '{{ csrf_token() }}';
                        d.start_date = $('#start_date').val();
                        d.end_date = $('#end_date').val();
                        d.status = $('#status').val();
                        d.staff_id = $('#staff_id').val();
                        d.day_type = $('#day_type').val();
                    }
                },
                columns: [{
                        data: 'DT_RowIndex',
                        orderable: false,
                        searchable: false
                    },
                    {
                        data: 'customer_name',
                        name: 'customer_name'
                    },
                    {
                        data: 'customer_phone',
                        name: 'customer_phone'
                    },
                    {
                        data: 'date',
                        name: 'date'
                    },
                    {
                        data: 'slot_time',
                        name: 'slot_time'
                    },
                    {
                        data: 'service_discount',
                        name: 'service_discount'
                    },
                    {
                        data: 'service_tip',
                        name: 'service_tip'
                    },
                    {
                        data: 'service_total_amt',
                        name: 'service_total_amt'
                    },
                    {
                        data: 'status_badge',
                        name: 'status_badge',
                        orderable: false,
                        searchable: false
                    }
                ]
            });

            var ReportPaymentList = $('#ReportPaymentMethodsTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: "{{ route('admin.reports.get-report-payment') }}",
                    type: "POST",
                    data: function(d) {
                        d._token = '{{ csrf_token() }}';
                        d.start_date = $('#start_date').val();
                        d.end_date = $('#end_date').val();
                        d.status = $('#status').val();
                        d.staff_id = $('#staff_id').val();
                        d.day_type = $('#day_type').val();
                    }
                },
                columns: [{
                        data: 'method',
                        name: 'method'
                    },
                    {
                        data: 'total_revenue',
                        name: 'total_revenue'
                    }
                ]
            });

            var StaffPerformanceDataTable = $('#StaffPerformanceDataTable').DataTable({
                processing: true,
                serverSide: true,
                ajax: {
                    url: "{{ route('admin.reports.get-staff-performance') }}", // 👈 अपना route यहां डालें
                    type: "POST",
                    data: function(d) {
                        d._token = '{{ csrf_token() }}';
                        d.start_date = $('#start_date').val();
                        d.end_date = $('#end_date').val();
                        d.status = $('#status').val();
                        d.staff_id = $('#staff_id').val();
                        d.day_type = $('#day_type').val();
                    }
                },
                columns: [{
                        data: 'staff_name',
                        name: 'staff_name'
                    },
                    {
                        data: 'appointments',
                        name: 'appointments'
                    },

                    {
                        data: 'tips',
                        name: 'tips'
                    },
                    {
                        data: 'service_commission',
                        name: 'service_commission'
                    },
                    {
                        data: 'product_commission',
                        name: 'product_commission'
                    },
                    {
                        data: 'total_earn',
                        name: 'total_earn'
                    },
                    {
                        data: 'action',
                        name: 'action',
                        orderable: false,
                        searchable: false
                    }
                ]
            });


            // var ReportCategoryData = $('#ReportCategoryDataTable').DataTable({
            //     processing: true,
            //     serverSide: true,
            //     ajax: {
            //         url: "",
            //         type: "POST",
            //         data: function(d) {
            //             d._token = '{{ csrf_token() }}';
            //             d.start_date = $('#start_date').val();
            //             d.end_date = $('#end_date').val();
            //             d.status = $('#status').val();
            //             d.staff_id = $('#staff_id').val();
            //             d.day_type = $('#day_type').val();
            //         }
            //     },
            //     columns: [
            //         { data: 'service_name', name: 'service_name' },
            //         { data: 'appointmentCount', name: 'appointmentCount' },
            //         { data: 'totalRevenue', name: 'totalRevenue' },
            //         { data: 'total_service_tip', name: 'total_service_tip' },
            //         { data: 'service_total_discount', name: 'service_total_discount' },
            //         { data: 'service_price', name: 'service_price' }
            //     ]
            // });

            // 🔎 Function to update summary counts
            function updateSummary(json) {
                if (json.summary) {
                    $('#totalRevenue').text(json.summary.total_revenue);
                    $('#totalAppointments').text(json.summary.total_appointments);
                    $('#totalVisits').text(json.summary.total_visits);
                    $('#totalTips').text(json.summary.total_tips);
                }
            }

            // 🔎 Filter Button Click
            $('#filterBtn').on('click', function() {
                ReportAppointmentsList.ajax.reload(function(json) {
                    updateSummary(json);
                });
                ReportPaymentList.ajax.reload();
                StaffPerformanceDataTable.ajax.reload();
            });

            // ✅ Initial load of all tables and summary
            ReportAppointmentsList.ajax.reload(function(json) {
                updateSummary(json);
            });
            ReportPaymentList.ajax.reload();
            StaffPerformanceDataTable.ajax.reload();

        });
    </script>
    <script>
        document.querySelectorAll('.nav-tabs .nav-link').forEach(function(btn) {
            btn.addEventListener('click', function() {
                // Remove active class + reset styles from all buttons
                document.querySelectorAll('.nav-tabs .nav-link').forEach(function(el) {
                    el.classList.remove('active');
                    el.style.background = "linear-gradient(135deg, #f5f7fa, #e4e7eb)";
                    el.style.color = "#5a5a5a";
                });

                // Add active style to the clicked button
                this.classList.add('active');
                this.style.background = "linear-gradient(135deg, #4e54c8, #8f94fb)";
                this.style.color = "white";
            });
        });
    </script>
@endpush
