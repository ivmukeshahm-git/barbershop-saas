    <style>
        :root {
            --lx-blue: #0A66C2;
            --lx-blue-dark: #1E3A8A;
            --lx-navy: #0F172A;
            --lx-bg: #F8FAFC;
        }
        body {
            font-family: 'Inter', sans-serif !important;
            background: linear-gradient(160deg, #E8F2FC 0%, #F8FAFC 40%, #FFFFFF 100%) !important;
            background-attachment: fixed !important;
            min-height: 100vh;
            color: var(--lx-navy);
        }
        h1,h2,h3,h4,h5,h6 { font-family: 'Poppins', sans-serif; font-weight: 700; }
        .wizard-container { max-width: 1000px; margin: 2rem auto; }
        .wizard-container .card {
            border: none;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(10,102,194,0.12);
        }
        .wizard-container .card-header {
            background: linear-gradient(135deg, #0A66C2, #1E3A8A) !important;
            border: none;
            padding: 1.25rem 1.5rem;
        }
        .wizard-container .card-header h4 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
        }
        .wizard-topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 0 8px;
            max-width: 1000px;
            margin: 0 auto;
        }
        .wizard-topbar img { height: 48px; background: #fff; border-radius: 12px; padding: 4px 10px; }
        .wizard-topbar a.home-link {
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            color: #0A66C2;
            text-decoration: none;
            background: #fff;
            padding: 10px 18px;
            border-radius: 50px;
            box-shadow: 0 8px 24px rgba(10,102,194,0.12);
        }
        .progress-step.active { background-color: #0A66C2 !important; }
        .btn-primary {
            background: linear-gradient(135deg, #0A66C2, #1E3A8A) !important;
            border: none !important;
            border-radius: 50px !important;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            padding: 10px 22px;
        }
        .btn-outline-primary {
            border-radius: 50px !important;
            border-color: #0A66C2 !important;
            color: #0A66C2 !important;
            font-weight: 600;
        }
        .btn-outline-primary:hover {
            background: #0A66C2 !important;
            color: #fff !important;
        }
        .form-control, .form-select {
            border-radius: 14px !important;
            padding: 12px 14px;
            border: 1.5px solid rgba(15,23,42,0.1);
        }
        .form-control:focus, .form-select:focus {
            border-color: #0A66C2;
            box-shadow: 0 0 0 4px rgba(10,102,194,0.12);
        }
        .service-card, .staff-card { border-radius: 16px !important; }
        .summary-section { border-radius: 16px !important; border-color: rgba(10,102,194,0.1) !important; }
    </style>

    <style>

        .wizard-container {

            max-width: 1000px;

            margin: 2rem auto;

        }



        .step-content {

            display: none;

            animation: fadeIn 0.3s ease-in;

        }



        .step-content.active {

            display: block;

        }



        @keyframes fadeIn {

            from {

                opacity: 0;

                transform: translateY(10px);

            }



            to {

                opacity: 1;

                transform: translateY(0);

            }

        }



        .progress-step {

            width: 40px;

            height: 40px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: bold;

            position: relative;

        }



        .progress-step.completed {

            background-color: #198754;

            color: white;

        }



        .progress-step.active {

            background-color: #0A66C2;

            color: white;

        }



        .progress-step.pending {

            background-color: #e9ecef;

            color: #6c757d;

        }



        .progress-line {

            height: 2px;

            background-color: #e9ecef;

            flex: 1;

            margin: 0 10px;

            top: -14px;

            position: relative;

        }



        .progress-line.completed {

            background-color: #198754;

            top: -14px;

            position: relative;

        }



        .step-title {

            font-size: 0.875rem;

            margin-top: 0.5rem;

            text-align: center;

        }

    </style>

    <style>

        .service-btn-group .btn {

            border-radius: 8px 8px 8px 8px;

        }



        .service-btn-group .btn.active {

            background: #0A66C2;

            color: #fff;

            border-color: #0A66C2;

        }



        .service-btn-group .btn:not(.active) {

            background: #fff;

            color: #0A66C2;

            border-color: #0A66C2;

        }



        .service-card {

            border: 1.5px solid #ececec;

            border-radius: 12px;

            background: #fff;

            transition: box-shadow 0.15s;

            cursor: pointer;

        }



        .service-card:hover {

            box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.06);

        }



        .staff-card.selected {

            background: #0A66C2 !important;

            color: #fff !important;

            border-color: #0A66C2 !important;

        }



        .staff-card.selected .badge {

            background: #fff !important;

            color: #0A66C2 !important;

        }



        .staff-card {

            border: 1.5px solid #ececec;

            border-radius: 12px;

            background: #fff;

            min-height: 100px;

            cursor: pointer;

            transition: box-shadow 0.15s, background 0.15s;

        }



        .staff-card:hover {

            box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.06);

        }



        .service-card.active {

            border: 2px solid #0A66C2;

            background: #0A66C20f;

        }

    </style>



    <style>

        .toggle-tabs {

            display: flex;

            border-radius: 8px;

            border: 1px solid #E8F2FC;

            overflow: hidden;

            background: #fff;

            width: 100%;

        }



        .tab-btn {

            flex: 1;

            padding: 7px 0;

            background: none;

            border: none;

            font-weight: 500;

            font-size: 15px;

            color: #222;

            transition: background 0.2s, color 0.2s;

            cursor: pointer;

            outline: none;

        }



        .tab-btn.active {

            background: #1E3A8A;

            color: #fff;

            border-radius: 8px 0 0 8px;

            font-weight: bold;

        }



        .tab-btn:not(.active) {

            background: none;

            color: #222;

        }



        .tab-btn:last-child.active {

            border-radius: 0 8px 8px 0;

        }



        .slot-btn {

            background: #eee;

            color: #000;

        }

    </style>

    <style>

        .summary-card {

