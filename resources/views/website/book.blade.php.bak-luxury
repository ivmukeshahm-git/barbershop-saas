    <script>

        // Step One 

        $(document).ready(function() {

            $('.step-one-service-card').on('click', function() {

                // Toggle active class on click

                $(this).toggleClass('active');



                var total_duration = 0; // Initialize total duration



                // Collect all active service names

                var selected_service = [];

                $('.service-card.active').each(function() {

                    // Find the .fw-semibold inside this card

                    var serviceName = $(this).find('.service_id_select').val().trim();

                    selected_service.push(serviceName);



                    var duration = parseInt($(this).data('duration')) || 0; // Get duration from data attribute



                    total_duration += duration; // Sum durations

                });



                // Set comma-separated string to hidden input

                $('#step_one_staff_service').val(selected_service.join(','));

                $('#final_service_id').val(selected_service.join(','));





                $("#ServiceMinite").html(total_duration);

                $("#ServiceMinite1").html(total_duration);



                

            });





            $('.step-one-staff-card').on('click', function() {

                // Remove 'selected' class from all cards

                $('.step-one-staff-card').removeClass('selected');



                // Add 'selected' class to the clicked card

                $(this).addClass('selected');



                // Get the selected staff_id from the clicked card only

                var selectedstaff_id = $(this).find('.staff_id_select').val().trim();



                // Set the value to hidden input

                $('#step_one_staff_service').val(selectedstaff_id);

                $('#final_staff_id').val(selectedstaff_id);





            });



        });



        $(document).on('click', '.step-two-service-card', function() {

            // Toggle active class on click

            $(this).toggleClass('active');



            // Collect all active service ids

            var selected_service = [];

            $('.step-two-service-card.active').each(function() {

                var serviceId = $(this).find('.step_two_service_id_select').val().trim();

                selected_service.push(serviceId);

            });



            // Set comma-separated string to hidden input

            $('#step_two_staff_service').val(selected_service.join(','));

            $('#final_service_id').val(selected_service.join(','));

        });

        $(document).on('click', '.step-two-staff-card', function() {

            // Remove 'selected' class from all step-two staff cards

            $('.step-two-staff-card').removeClass('selected');



            // Add 'selected' class to the clicked card

            $(this).addClass('selected');



            // Get selected staff id from the clicked card

            var selectedstaff_id = $(this).find('.step_two_staff_id_select').val().trim();



            // Set value to hidden input

            $('#step_two_staff_service').val(selectedstaff_id);

            $('#final_staff_id').val(selectedstaff_id);

        });











        function showWizardTab(tab) {

            let byServicePanel = document.getElementById('byServicePanel');

            let byStaffPanel = document.getElementById('byStaffPanel');

            let byServiceBtn = document.getElementById('byServiceBtn');

            let byStaffBtn = document.getElementById('byStaffBtn');

            if (tab === 'service') {

                byServicePanel.classList.remove('d-none');

                byStaffPanel.classList.add('d-none');

                byServiceBtn.classList.add('active');

                byStaffBtn.classList.remove('active');



                document.getElementById("StepSecondType").innerHTML = "Select Staff";

                document.getElementById("ServiceByStaffStep").style.display = "none";

                document.getElementById("StaffByServiceStep").style.display = "block";





                $("step_two_select_type").val("Staff");



                $("#step_one_select_type").val("Service");

            } else {

                byServicePanel.classList.add('d-none');

                byStaffPanel.classList.remove('d-none');

                byServiceBtn.classList.remove('active');

                byStaffBtn.classList.add('active');



                document.getElementById("StepSecondType").innerHTML = "Select Service";



                document.getElementById("ServiceByStaffStep").style.display = "block";

                document.getElementById("StaffByServiceStep").style.display = "none";

                $("#step_one_select_type").val("Staff");



                $("step_two_select_type").val("Service");

            }

        }

    </script>



    <script>

        function SlotTime(typ) {

            let byMorning = document.getElementById('byMorning');

            let byEvening = document.getElementById('byEvening');

            let timeSlotsMorning = document.getElementById('timeSlotsMorning');

            let timeSlotsEvening = document.getElementById('timeSlotsEvening');



            if (typ === 'Morning') {

                timeSlotsMorning.classList.remove('d-none');

                timeSlotsEvening.classList.add('d-none');

                byMorning.classList.add('active');

                byEvening.classList.remove('active');

            } else {

                timeSlotsMorning.classList.add('d-none');

                timeSlotsEvening.classList.remove('d-none');

                byMorning.classList.remove('active');

                byEvening.classList.add('active');

            }

        }

    </script>

    <script>

      function loadServiceStaff(staff_service_id, select_type) {

            var data = {

                'staff_service_id': staff_service_id,

                'select_type': select_type,

            }



            $.ajaxSetup({

                headers: {

                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')

                }

            });



            $.ajax({

                type: "POST",

                url: "{{ route('get-staff-service') }}",

                data: data,

                dataType: "json",

                success: function(response) {



                    if (response.status == 1) {

                        // -------- When user selects SERVICE (show services grouped by category)

                        if (select_type === "Service") {

                            var staffs = response.staff; // backend से staff list



                            const storagePath = "{{ asset('storage') }}/";

                            const defaultImg = "{{ asset('assets/img/user.png') }}";





                            let html = '';

                            if (staffs && staffs.length > 0) {

                                staffs.forEach(staff => {

                                    let profileImg = staff.profile_img ?

                                        storagePath + staff.profile_img :

                                        defaultImg;





                                    html += `

        <div class="col-12 col-sm-6 col-md-4">

            <div class="staff-card step-two-staff-card d-flex align-items-center p-3 justify-content-between">

                <input type="hidden" 

                    id="step_two_staff_id" 

                    name="step_two_staff_id"

                    value="${staff.id}" 

                    class="step_two_staff_id_select">

                

                <div class="d-flex align-items-center">

                    <img src="${profileImg}" 

                        class="rounded-circle me-3" 

                        width="48" height="48"

                        alt="${staff.name || 'Staff'}" />

                    

                    <div>

                        <div class="fw-semibold">${staff.name}</div>

                    </div>

                </div>

                

                <span class="badge bg-light fw-semibold border border-success text-success ms-2">

                    Available

                </span>

            </div>

        </div>

    `;

                                });

                            } else {

                                html = `

        <div class="col-12">

            <div style="text-align: center;">

                <i class="fa fa-exclamation-circle me-2"></i>

                Staff Not Available

            </div>

        </div>

    `;

                            }



                            $("#StepTwoStaffHtml").html(`<div class="row g-3">${html}</div>`);

                        }

                        // -------- When user selects STAFF (show staff & his services)

                        else if (select_type === "Staff") {

                            var data = response.data; // अब category-wise आएगा



                            console.log(data);

                            let StaffList = ``;



                            if (data && data.length > 0) {

                                data.forEach(category => {

                                    StaffList += `

            <div class="card px-4 py-3 border-0 shadow-sm mb-3" style="background: #eee;">

                <div class="fw-bold fs-6 mb-2">

                    ${category.category_name} <i class="bx bx-chevron-down align-baseline"></i>

                </div>

                <div class="row g-3">`;



                                    if (category.services && category.services.length > 0) {

                                        category.services.forEach(service => {

                                            StaffList += `

                    <div class="col-md-6 col-lg-4">

                        <div class="service-card step-two-service-card px-3 py-3 h-100 d-flex flex-column justify-content-between" 

                             data-duration="${service.duration}">

                             

                            <input type="hidden" 

                                class="step_two_service_id_select" 

                                value="${service.service_id}">

                            

                            <div class="fw-semibold">${service.service_name}</div>

                            

                            <div class="d-flex justify-content-between align-items-center mt-2">

                                <div class="text-muted"><i class="bx bx-time"></i> ${service.duration} min</div>

                                <div class="fw-bold text-danger fs-6">$${service.price}</div>

                            </div>

                        </div>

                    </div>`;

                                        });

                                    } else {

                                        StaffList += `

                <div class="col-12">

                    <div class="text-center text-muted">

                        <i class="fa fa-exclamation-circle me-2"></i>

                        No Services Available in this Category

                    </div>

                </div>`;

                                    }



                                    StaffList += `</div></div>`;

                                });

                            } else {

                                StaffList = `

        <div class="col-12">

            <div class="alert alert-warning text-center mb-0">

                <i class="fa fa-exclamation-circle me-2"></i>

                Service Not Available

            </div>

        </div>`;

                            }



                            $("#StepTwoServiceHtml").html(StaffList);





                        }

                    } else {

                        console.error("No data found");

                    }

                }

            });



            return false;

        }



        function updateStepIndicators(oldStep, newStep) {

            // Update old step indicator

            const oldIndicator = document.getElementById(`step-indicator-${oldStep}`);

            if (newStep > oldStep) {

                oldIndicator.className = 'progress-step completed';

                oldIndicator.innerHTML = '<i class="bi bi-check"></i>';



                // Update progress line

                if (oldStep < totalSteps) {

                    document.getElementById(`line-${oldStep}`).classList.add('completed');

                }

            } else {

                oldIndicator.className = 'progress-step pending';

                oldIndicator.textContent = oldStep;



                // Update progress line

                if (oldStep < totalSteps) {

                    document.getElementById(`line-${oldStep}`).classList.remove('completed');

                }

            }



            // Update new step indicator

            const newIndicator = document.getElementById(`step-indicator-${newStep}`);

            newIndicator.className = 'progress-step active';

            newIndicator.textContent = newStep;

        }



        function updateButtons() {

            const prevBtn = document.getElementById('prevBtn');

            const nextBtn = document.getElementById('nextBtn');



            prevBtn.disabled = currentStep === 1;



            if (currentStep === totalSteps) {

                nextBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Book Now';

                nextBtn.onclick = completeWizard;

            } else {

                nextBtn.innerHTML = 'Next <i class="bi bi-arrow-right ms-1"></i>';

                nextBtn.onclick = () => changeStep(1);

            }

        }



        function completeWizard() {

            const agreeTerms = document.getElementById('agreeTerms').checked;



            if (!agreeTerms) {

                alert('Please agree to the Terms of Service and Privacy Policy to continue.');

                return;

            }



            // Simulate form submission

            const nextBtn = document.getElementById('nextBtn');

            nextBtn.disabled = true;

            nextBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';



            setTimeout(() => {

                alert('Account setup completed successfully! Welcome aboard!');

                nextBtn.disabled = false;

                nextBtn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Complete Setup';

            }, 2000);

        }

    </script>

    <script>

        // Calendar rendering

        const currentDate = new Date();

        let selectedYear = currentDate.getFullYear();

        let selectedMonth = currentDate.getMonth(); // 0-based (Jan = 0)

        let selectedDay = currentDate.getDate(); // Today's date by default

        let dayName = new Intl.DateTimeFormat('en-US', {

            weekday: 'long'

        }).format(currentDate);



        let currentStep = 1;

        const totalSteps = 5;



        function changeStep(direction, skipValidation = false) {

            if (!skipValidation) {

                if (currentStep == 1) {

                    let step_one_staff_service = $("#step_one_staff_service").val();

                    if (!step_one_staff_service) {

                        alert("Please Select Service Or Staff");

                        return false;

                    }

                    let step_one_select_type = $("#step_one_select_type").val();

                    loadServiceStaff(step_one_staff_service, step_one_select_type);

                } else if (currentStep == 2) {

                    let final_staff_id = $("#final_staff_id").val();

                    let final_service_id = $("#final_service_id").val();

                    if (!final_staff_id || !final_service_id) {

                        alert("Please Select Service or Staff");

                        return false;

                    }

                    const currentDate = new Date();

                    let selectedDay = currentDate.getDate();

                    selectDay(selectedDay);

                } else if (currentStep == 3) {

                    let selectedSlotStartValue = $("#selectedSlotStartValue").val();

                    if (!selectedSlotStartValue) {

                        alert("Please Select Slot");

                        return false;

                    }

                } else if (currentStep == 4) {

                    let phone_number = $("#phone_number").val();

                    let full_name = $("#full_name").val();

                    if (!phone_number) {

                        alert("Please Enter Phone No.");

                        return false;

                    } else if (!full_name) {

                        alert("Please Enter Full Name.");

                        return false;

                    }

                    FetchAppointmentDetails();

                }

            }



            const newStep = currentStep + direction;

            if (newStep < 1 || newStep > totalSteps) return;



            document.getElementById(`step-${currentStep}`).classList.remove("active");

            updateStepIndicators(currentStep, newStep);

            currentStep = newStep;

            document.getElementById(`step-${currentStep}`).classList.add("active");

            updateButtons();

        }





        function updateButtons() {

            const prevBtn = document.getElementById("prevBtn");

            const nextBtn = document.getElementById("nextBtn");



            // Enable/disable prev button

            prevBtn.disabled = currentStep === 1;



            if (currentStep === totalSteps) {

                // Change Next to Finish

                nextBtn.innerHTML = `Finish <i class="bi bi-check-lg ms-1"></i>`;

                nextBtn.onclick = function() {

                    updateReviewSection();

                };

            } else {

                // Change back to Next

                nextBtn.innerHTML = `Next <i class="bi bi-arrow-right ms-1"></i>`;

                nextBtn.onclick = function() {

                    changeStep(1);

                };

            }

        }



        // Called only on Finish

        function updateReviewSection() {

            var staff_id = $("#final_staff_id").val();

            var service_id = $("#final_service_id").val();

            var slot_start = $("#selectedSlotStartValue").val();

            var slot_end = $("#selectedSlotEndValue").val();



            var phone_number = $("#phone_number").val();

            var full_name = $("#full_name").val();

            var email = $("#email").val();

            var note = $("#note").val();

            var total_amt = $("#total_amt").val();



            // Create a proper Date object (month is 0-based in JS, so subtract 1)

            let dateObj = new Date(selectedYear, selectedMonth, selectedDay);



            // Pad month/day with leading zero

            let year = dateObj.getFullYear();

            let month = String(dateObj.getMonth() + 1).padStart(2, '0'); // add 1 because month is 0-based

            let day = String(dateObj.getDate()).padStart(2, '0');



            let selectedDate = `${year}-${month}-${day}`;



            var data = {

                "staff_id": staff_id,

                "service_id": service_id,

                "slot_start": slot_start,

                "slot_end": slot_end,

                "phone_number": phone_number,

                "full_name": full_name,

                "email": email,

                "note": note,

                "date": selectedDate,

                "total_amt": total_amt

            }

            

            

            document.getElementById("Loader").style.display = "block";





            $.ajaxSetup({

                headers: {

                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')

                }

            });



            $.ajax({

                type: "POST",

                url: "{{ route('submit-appointment-details') }}",

                data: data,

                dataType: "json",

                success: function(response) {

                    document.getElementById("Loader").style.display = "none";

                    if (response.status === 1) {

                        

                        


                        Swal.fire({

                                            icon: 'success',

                                            title: 'Success',

                                            text: response.message,

                                            showConfirmButton: false,

                                            timer: 2000

                                        });



                        setTimeout(function() {

                            window.location.href =

                                "{{ route('home') }}";

                        }, 3000);
 gtag('event', 'conversion', {

                            'send_to': 'AW-17733466405/hfY5CLST8c4bEKXy_IdC',

                            'value': total_amt,

                            'currency': 'CAD'

                          });

                    } else {

                        alert(response.message);

                    }

                }

            });

            return false;

        }





        function FetchAppointmentDetails() {

            var staff_id = $("#final_staff_id").val();

            var service_id = $("#final_service_id").val();

            var slot_start_value = $("#selectedSlotStartValue").val();

            var slot_end_value = $("#selectedSlotEndValue").val();





            var phone_number = $("#phone_number").val();

            var full_name = $("#full_name").val();

            var email = $("#email").val();

            var note = $("#note").val();



            $("#PreviewName").html(full_name);

            $("#PreviewEmail").html(email);

            $("#PreviewPhone").html(phone_number);

            $("#PreviewNote").html(note);





            var data = selectedYear + "-" + selectedMonth + "-" + selectedDay;





            // Create a proper Date object (month is 0-based in JS, so subtract 1)

            var dateObj = new Date(selectedYear, selectedMonth, selectedDay);



            // Format into "September 8, 2025"

            var formattedDate = dateObj.toLocaleDateString("en-US", {

                year: "numeric",

                month: "long",

                day: "numeric"

            });







            var slot_start_display = formatTimeWithAmPm(slot_start_value);



            $("#AppointmentDate").html(formattedDate + " at " + slot_start_display)





            var data = {

                'staff_id': staff_id,

                'service_id': service_id,

                'slot_start_value': slot_start_value,

                'slot_end_value': slot_end_value,

            }





            $.ajaxSetup({

                headers: {

                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')

                }

            });



            $.ajax({

                type: "POST",

                url: "{{ route('get-appointment-details') }}",

                data: data,

                dataType: "json",

                success: function(response) {

                    if (response.status === 1) {



                        var staff = response.staff;

                        var services = response.services;



                        var serviceList = ``;

                        var totalPrice = 0;

                        var totalDurection = 0;



                        services.forEach(element => {

                            // Add up price

                            totalPrice += parseFloat(element.price);

                            totalDurection += parseFloat(element.duration);



                            serviceList += `

        <div class="service-row">

            <div>

                <div class="service-name">${element.service_name}</div>

                <div class="service-duration">

                    <i class="fa fa-clock-o"></i> ${element.duration} min

                </div>

            </div>

            <div class="service-price">$${parseFloat(element.price).toFixed(2)}</div>

        </div>

    `;

                        });



                        var ServiceHtml = `

    ${serviceList}

    <div class="service-row total-row">

        <div class="service-total-label">Total</div>

        <div class="service-price service-total-amount">$${totalPrice.toFixed(2)}</div>

    </div>

`;



                        $("#ViewServiceHtml").html(ServiceHtml);

                        $("#TotalDuration").html(totalDurection + " Minite");



                        $("#total_amt").val(totalPrice);



                        var StffHtml = `

    <div class="summary-row">

        <span class="summary-icon"><i class="fa fa-user-o"></i></span>

        <div class="summary-label">Staff</div>

    </div>

    <div class="staff-details">

        <span class="staff-avatar">${staff.name.charAt(0)}</span>

        <span class="staff-name">${staff.name}</span>

    </div>

`;



                        $("#ViewStaffHtml").html(StffHtml);



                    } else {

                        Swal.fire({

                            icon: 'warning',

                            title: 'Warning',

                            text: response.message,

                            showConfirmButton: false,

                            timer: 2000

                        });

                    }

                }

            });

            return false;



        }





        function formatTimeWithAmPm(time) {

            let [hour, minute] = time.split(":").map(Number);

            let ampm = hour >= 12 ? "PM" : "AM";

            hour = hour % 12 || 12; // convert "0" to "12"

            return `${hour}:${minute.toString().padStart(2, "0")} ${ampm}`;

        }













        const calendarMonth = document.getElementById('calendarMonth');

        const calendarBody = document.getElementById('calendarBody');

        const prevMonthBtn = document.getElementById('prevMonthBtn');

        const nextMonthBtn = document.getElementById('nextMonthBtn');



        // Helper to get days in month:

        function daysInMonth(year, month) {

            return new Date(year, month + 1, 0).getDate();

        }



       function renderCalendar() {

            calendarMonth.textContent = new Date(selectedYear, selectedMonth).toLocaleString('default', {

                month: 'long',

                year: 'numeric'

            });

            calendarBody.innerHTML = '';



            const firstDay = new Date(selectedYear, selectedMonth, 1).getDay();

            const numDays = daysInMonth(selectedYear, selectedMonth);

            const today = new Date(); // current date

            const todayYear = today.getFullYear();

            const todayMonth = today.getMonth();

            const todayDay = today.getDate();



            let tr = document.createElement('tr');



            // Blank days start

            for (let i = 0; i < firstDay; i++) {

                tr.appendChild(document.createElement('td'));

            }



            // Days

            for (let day = 1; day <= numDays; day++) {

                if (tr.children.length === 7) {

                    calendarBody.appendChild(tr);

                    tr = document.createElement('tr');

                }



                const td = document.createElement('td');

                td.className = "text-center slot-date";



                // check if this date is before today

                const isPastDay =

                    (selectedYear < todayYear) ||

                    (selectedYear === todayYear && selectedMonth < todayMonth) ||

                    (selectedYear === todayYear && selectedMonth === todayMonth && day < todayDay);



                if (isPastDay) {

                    td.innerHTML = `<button class="btn btn-sm px-2 py-1 btn-secondary text-white" disabled>${day}</button>`;

                } else {

                    td.innerHTML = `<button class="btn btn-sm px-2 py-1 ${day === selectedDay ? 'btn-primary text-white fw-semibold' : 'btn-light'}" 

                onclick="selectDay(${day})">${day}</button>`;

                }



                tr.appendChild(td);

            }



            // Fill remaining days

            while (tr.children.length < 7) {

                tr.appendChild(document.createElement('td'));

            }

            calendarBody.appendChild(tr);

        }



        function selectDay(day) {

            $("#MorningSlotHtml").html(""); // reset container



            selectedDay = day; // सिर्फ selectedDay update होगा

            var final_staff_id = $("#final_staff_id").val();

            var final_service_id = $("#final_service_id").val();





            let selectedDate = new Date(selectedYear, selectedMonth, selectedDay); // month is 0-based



            // Get full day name

            let dayName = new Intl.DateTimeFormat('en-US', {

                weekday: 'long'

            }).format(selectedDate);



            var data = {

                'selectedYear': selectedYear,

                'selectedMonth': selectedMonth,

                'selectedDay': selectedDay,

                'staff_id': final_staff_id,

                'service_id': final_service_id,

                'day_name': dayName

            }





            console.log(data);



            $.ajaxSetup({

                headers: {

                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')

                }

            });



            $.ajax({

                type: "POST",

                url: "{{ route('get-slot-by-staff') }}",

                data: data,

                dataType: "json",

                success: function(response) {

                    console.log(response);

                    if (response.status == 1) {







                        // Render morning slots

                            if (response.slots && response.slots.length) {

                            let MorningSlotHtml = '';

                            response.slots.forEach(slot => {

                                const slotText = formatTime(slot.start); // convert to 12h format

                                slotTimes.push(slot.start); // keep original time in global array



                                MorningSlotHtml += `

            <div class="col-auto">

                <button type="button" 

                        class="btn btn-outline-light border text-start d-flex align-items-center slot-btn" 

                        onclick="selectSlot(this, '${slot.start}', '${slot.end}')">

                    <i class="bx bx-time me-1"></i> ${slotText}

                </button>

            </div>

        `;

                            });



                            $("#MorningSlotHtml").html(MorningSlotHtml); // reset container

                        } else {

                            $("#MorningSlotHtml").html(

                                "<p class='shop-close-error text-danger fw-semibold'>Slot Not Available</p>"

                            );

                        }





                        selectedDay = day;

                        renderCalendar();

        

                    } else {

                        $("#MorningSlotHtml").html("<p class='shop-close-error'>" + response.message + "</p>");

                        $("#EveningSlotHtml").html("<p class='shop-close-error'>" + response.message + "</p>");

                    }





                }

            });

            return false;

        }

        

        

        

        function formatTime(timeStr) {

            let [hours, minutes] = timeStr.split(':').map(Number);

            let ampm = hours >= 12 ? 'PM' : 'AM';

            hours = hours % 12 || 12; // convert 0 -> 12

            hours = hours < 10 ? "0" + hours : hours; // add leading zero

            return `${hours}:${minutes.toString().padStart(2, '0')} ${ampm}`;

        }



        function selectSlot(button, start, end) {

            // Remove 'active' class from all buttons

            document.querySelectorAll('.slot-btn').forEach(btn => {

                btn.classList.remove('active');

            });



            // Add 'active' class to clicked button

            button.classList.add('active');



            // Store selected value in hidden inputs

            document.getElementById('selectedSlotStartValue').value = start; // start time

            document.getElementById('selectedSlotEndValue').value = end; // end time

        }









        // Navigation

        prevMonthBtn.onclick = () => {

            if (selectedMonth > 0) {

                selectedMonth--;

            } else {

                selectedYear--;

                selectedMonth = 11;

            }

            renderCalendar();

        };

        nextMonthBtn.onclick = () => {

            if (selectedMonth < 11) {

                selectedMonth++;

            } else {

                selectedYear++;

                selectedMonth = 0;

            }

            renderCalendar();

        };

        // For demo, keep static month/year as per your image

        renderCalendar();



        // Time slots

        const slotTimes = [

            '9:00 AM', '9:30 AM', '10:00 AM',

            '10:30 AM', '11:00 AM', '11:30 AM',

            '12:00 PM', '12:30 PM', '1:00 PM',

            '1:30 PM', '2:00 PM', '2:30 PM',

            '3:00 PM', '3:30 PM', '4:00 PM',

            '4:30 PM', '5:00 PM', '5:30 PM'

        ];

        const timeSlotsDiv = document.getElementById('timeSlots');

        let selectedSlot = null;

        // For demo: only enable up to and including 4:30 PM

        const enabledSlots = 16;







        // function selectSlot(i) {

        //     selectedSlot = i;

        //     // renderTimeSlots();

        // }

        // renderTimeSlots();

        window.selectDay = selectDay;

        // window.selectSlot = selectSlot;

    </script>

</body>



</html>

